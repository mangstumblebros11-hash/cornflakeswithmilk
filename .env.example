# Required: one Discord webhook used for all categories.
DISCORD_WEBHOOK_URL=

# Optional: separate webhooks override DISCORD_WEBHOOK_URL for one category.
DISCORD_WEBHOOK_OG=
DISCORD_WEBHOOK_HIGHLIGHT=
DISCORD_WEBHOOK_PEAKLIGHT=

# Optional: set this empty to disable @everyone on OG notifications.
DISCORD_OG_MENTION=@everyone

# Optional: move state/log files to a persistent mounted directory.
STATE_DIR=state